# Apache overrides for xm-player static deploy (copied to dist/ root by Vite).
# Ensures CSS is served as UTF-8 text, not mis-detected utf-16.
# COOP/COEP match Vite dev (require-corp) so the page is crossOriginIsolated, Safari included.

<IfModule mod_headers.c>
  # Clear both mod_headers tables (onsuccess and always) so a parent vhost's COEP cannot leave a
  # second value behind; a duplicated COEP is ignored by browsers.
  Header unset Cross-Origin-Embedder-Policy
  Header always unset Cross-Origin-Embedder-Policy
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"

  <FilesMatch "\.css$">
    Header set Content-Type "text/css; charset=utf-8"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  # libopenmpt-worklet.wasm is on the default JS engine's critical path. The right MIME type lets
  # the main-thread glue use WebAssembly.instantiateStreaming (it falls back to ArrayBuffer
  # instantiation with a console warning otherwise).
  AddType application/wasm .wasm
  # FX rack room IRs (#453), fetched by audio/fx/room/irLoader.ts.
  AddType audio/ogg .opus
  AddType text/css .css
  RemoveCharset .css
  AddType text/html .html
  RemoveCharset .html
</IfModule>

# Always serve the Vite-built index.html for directory requests (not a stale UTF-16 copy).
DirectoryIndex index.html
