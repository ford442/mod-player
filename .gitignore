# Dependencies
node_modules/
# package-lock.json is committed for reproducible installs (use `npm ci` in CI).

# Build outputs
dist/
build.log
*.log
logs/

# IDE/editor files
.idea/
.vscode/
*.swp
*.swo
*~
.aider*

# Editor backup/swap files
*.kate-swp
*.bak
* back*

# Planning docs (moved to docs/planning/)
.kimi/

# Verification artifacts
verification/
artifacts/

# Vendor source (cloned by build scripts)
vendor/
# Legacy duplicate — never commit; use vendor/ via scripts/build-wasm.sh
libopenmpt-0.8.4+release/

# OS files
.DS_Store
Thumbs.db

# Python bytecode cache (deploy.py)
__pycache__/
*.pyc

# Emscripten default-name leftovers (never commit)
a.out
a.out.*

# Agent planning scratch (local only; use docs/planning/ROADMAP.md for tracked roadmap)
.swarm-state.md
weekly_plan.md

# CodeQL self-referential symlink (scanner may recreate; never commit)
_codeql_detected_source_root

# Accidental local helpers (use git/gh CLI directly)
git.sh

# Outputs of the retired native C++ engine (docs/ADR-native-engine.md): never commit a stale local
# build; verify-build fails if one reaches dist/
/public/worklets/openmpt-native.*
/dist/worklets/openmpt-native.*
# openmpt-worklet.js (generated from TS) and libopenmpt-worklet.{js,wasm} (real-WASM JS engine,
# scripts/build-js-libopenmpt.sh) are tracked
/public/worklets/openmpt-worklet.wasm
/public/worklets/openmpt-worklet.aw.js
/dist/worklets/openmpt-worklet.wasm
/dist/worklets/openmpt-worklet.aw.js

# Local env files
.env
.env.local

# Browser-automation scratch output (Playwright runner / MCP browser) — never source
test-results/
playwright-report/
.playwright-mcp/
